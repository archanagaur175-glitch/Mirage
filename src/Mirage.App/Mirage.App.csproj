<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mirage.App</RootNamespace>
    <AssemblyName>Mirage</AssemblyName>
    <!-- Restrict to modern RIDs so the Windows App SDK package does not inject
         legacy win10-* RuntimeIdentifiers that newer .NET SDKs reject. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Run the XAML compiler in-process (managed) instead of exec'ing the
         net472 XamlCompiler.exe, which fails silently under `dotnet build` on CI. -->
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mirage.Core\Mirage.Core.csproj" />
    <ProjectReference Include="..\Mirage.Native\Mirage.Native.csproj" />
  </ItemGroup>

</Project>
