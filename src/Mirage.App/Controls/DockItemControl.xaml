<UserControl
    x:Class="Mirage.App.Controls.DockItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mirage.App.Controls">
    <Grid Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Rectangle x:Name="Icon" RadiusX="10" RadiusY="10" Width="44" Height="44" Fill="{StaticResource MirageAccentBrush}" />
        <Ellipse x:Name="RunningDot" Width="6" Height="6" Fill="#FF28C840"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                 Visibility="Collapsed" />
        <Border x:Name="Badge" CornerRadius="8" Background="#FFFF5F57" Padding="4,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="10" />
        </Border>
    </Grid>
</UserControl>
