<Application
    x:Class="Mirage.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mirage.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Tahoe-inspired "Liquid Glass" color tokens -->
            <Color x:Key="MirageGlassLight">#B8FFFFFF</Color>
            <Color x:Key="MirageGlassDark">#A01C1C1E</Color>
            <Color x:Key="MirageAccent">#FF0A84FF</Color>
            <Color x:Key="MirageRed">#FFFF5F57</Color>
            <Color x:Key="MirageYellow">#FFFEBC2E</Color>
            <Color x:Key="MirageGreen">#FF28C840</Color>
            <Color x:Key="MirageTextLight">#FF1D1D1F</Color>
            <Color x:Key="MirageTextDark">#FFF5F5F7</Color>
            <Color x:Key="MirageTextSecondaryLight">#FF6E6E73</Color>
            <Color x:Key="MirageTextSecondaryDark">#FF98989D</Color>

            <SolidColorBrush x:Key="MirageAccentBrush" Color="{StaticResource MirageAccent}" />
            <SolidColorBrush x:Key="MirageRedBrush" Color="{StaticResource MirageRed}" />
            <SolidColorBrush x:Key="MirageYellowBrush" Color="{StaticResource MirageYellow}" />
            <SolidColorBrush x:Key="MirageGreenBrush" Color="{StaticResource MirageGreen}" />
            <SolidColorBrush x:Key="MirageGlassLightBrush" Color="{StaticResource MirageGlassLight}" />
            <SolidColorBrush x:Key="MirageGlassDarkBrush" Color="{StaticResource MirageGlassDark}" />

            <!-- Spacing system (4px base unit) -->
            <x:Double x:Key="MirageSpaceXs">4</x:Double>
            <x:Double x:Key="MirageSpaceSm">8</x:Double>
            <x:Double x:Key="MirageSpaceMd">12</x:Double>
            <x:Double x:Key="MirageSpaceLg">16</x:Double>
            <x:Double x:Key="MirageSpaceXl">24</x:Double>
            <x:Double x:Key="MirageSpaceXxl">32</x:Double>

            <!-- Typography scale -->
            <x:Double x:Key="MirageCaption">11</x:Double>
            <x:Double x:Key="MirageBody">13</x:Double>
            <x:Double x:Key="MirageBodyEmph">14</x:Double>
            <x:Double x:Key="MirageSubhead">17</x:Double>
            <x:Double x:Key="MirageTitle">22</x:Double>
            <x:Double x:Key="MirageLargeTitle">28</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
