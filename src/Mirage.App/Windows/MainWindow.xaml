<Window
    x:Class="Mirage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mirage.App"
    xmlns:controls="using:Mirage.App.Controls"
    Title="Mirage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar with macOS-style traffic lights -->
        <Grid Grid.Row="0" Height="44" Background="{StaticResource MirageGlassDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:TrafficLightsControl x:Name="Lights" Grid.Column="0" Margin="14,0,0,0" />
            <TextBlock Grid.Column="1" Text="Mirage" Foreground="#FFF5F5F7"
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="18">
                <TextBlock Text="Mirage" FontSize="28" FontWeight="SemiBold" Foreground="#FFF5F5F7" />
                <TextBlock Text="Turn Windows 11 into macOS Tahoe."
                           FontSize="13" Foreground="#FF98989D" Margin="0,-10,0,6" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Features" FontSize="17" FontWeight="SemiBold" Foreground="#FFF5F5F7" />
                    <ToggleSwitch x:Name="DockToggle" Header="Fluid Dock" Toggled="OnDockToggled" />
                    <ToggleSwitch x:Name="HudToggle" Header="Top Status HUD" Toggled="OnHudToggled" />
                    <ToggleSwitch x:Name="TrafficToggle" Header="Traffic Lights" Toggled="OnTrafficToggled" />
                    <ToggleSwitch x:Name="TaskbarToggle" Header="Hide Taskbar" Toggled="OnTaskbarToggled" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <Button x:Name="SetupButton" Content="Theme &amp; Asset Wizard"
                            Click="OnSetup" HorizontalAlignment="Stretch" />
                    <Button x:Name="SettingsButton" Content="Settings"
                            Click="OnSettings" HorizontalAlignment="Stretch" />
                    <Button x:Name="RevertButton" Content="Instant Safe Revert"
                            Click="OnRevert" HorizontalAlignment="Stretch"
                            Background="#FFFF5F57" Foreground="White" />
                </StackPanel>

                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#FF98989D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
