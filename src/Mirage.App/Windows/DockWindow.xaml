<Window
    x:Class="Mirage.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mirage.App"
    xmlns:controls="using:Mirage.App.Controls"
    Title="Mirage Dock"
    Height="86">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#B8FFFFFF" />
        </Grid.Background>
        <controls:MagnifyDockPanel x:Name="Panel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
    </Grid>
</Window>
